nalEdgeStyle;rounded=0;html=1;strokeColor=#999999;endArrow=block;strokeWidth=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="s11" target="s12" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1527" y="465"/><mxPoint x="292" y="465"/></Array></mxGeometry></mxCell><mxCell id="es12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;endArrow=block;strokeWidth=1;" parent="1" source="s12" target="s13" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;endArrow=block;strokeWidth=1;" parent="1" source="s13" target="s14" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend_hdr" value="图例" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontStyle=1;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="20" y="565" width="40" height="25" as="geometry"/></mxCell><mxCell id="leg1" value="手动操作（不纳入自动化）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;" parent="1" vertex="1"><mxGeometry x="70" y="562" width="150" height="30" as="geometry"/></mxCell><mxCell id="leg2" value="电磁阀门自动控制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" parent="1" vertex="1"><mxGeometry x="240" y="562" width="130" height="30" as="geometry"/></mxCell><mxCell id="leg3" value="电磁阀门+智能检测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" parent="1" vertex="1"><mxGeometry x="390" y="562" width="140" height="30" as="geometry"/></mxCell><mxCell id="leg4_txt" value="阶段间推进" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="550" y="567" width="70" height="20" as="geometry"/></mxCell><mxCell id="leg4_line" value="" style="endArrow=block;html=1;strokeColor=#666666;strokeWidth=2;dashed=1;" parent="1" edge="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="620" y="577" as="sourcePoint"/><mxPoint x="660" y="577" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mod_hdr" value="三大核心技术模块" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;fontColor=#1a1a2e;" parent="1" vertex="1"><mxGeometry x="720" y="555" width="180" height="30" as="geometry"/></mxCell><mxCell id="modA_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#d79b00;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="720" y="595" width="250" height="120" as="geometry"/></mxCell><mxCell id="modA_t" value="🔧 模块A：电磁阀门控制系统" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;fontColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="735" y="600" width="220" height="22" as="geometry"/></mxCell><mxCell id="modA_c" value="• 开关型电磁阀（20个/1线，法兰盘式）&lt;br&gt;• 线性电磁阀（4个/1线，0-90°可调）&lt;br&gt;• 电子流量计（4台，4-20mA+RS485）&lt;br&gt;• 衬四氟(PTFE)防腐 + 反馈信号&lt;br&gt;• PLC控制 + 二次确认防误操作" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#555555;" parent="1" vertex="1"><mxGeometry x="735" y="628" width="221" height="59" as="geometry"/></mxCell><mxCell id="modB_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF0;strokeColor=#82b366;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="1000" y="595" width="250" height="120" as="geometry"/></mxCell><mxCell id="modB_t" value="👁 模块B：YOLO视觉识别系统" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;fontColor=#82b366;" parent="1" vertex="1"><mxGeometry x="1015" y="600" width="220" height="22" as="geometry"/></mxCell><mxCell id="modB_c" value="• 密闭无光检测仓 + LED标准环形光源&lt;br&gt;• YOLOv8目标检测模型（颜色特征识别）&lt;br&gt;• 三分类：未达标/合格(青蓝)/异常&lt;br&gt;• 训练数据≥5000张，mAP≥95%&lt;br&gt;• NVIDIA Jetson Orin Nano边缘推理" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#555555;" parent="1" vertex="1"><mxGeometry x="1015" y="628" width="220" height="80" as="geometry"/></mxCell><mxCell id="modC_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#9673a6;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="1280" y="595" width="250" height="120" as="geometry"/></mxCell><mxCell id="modC_t" value="⚖ 模块C：双动力检测系统" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;fontColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="1295" y="600" width="200" height="22" as="geometry"/></mxCell><mxCell id="modC_c" value="• 双动力传动机构 + 虹膜固定容器&lt;br&gt;• 压力传感器自由落体称重（比重1.05-1.08）&lt;br&gt;• 摇晃混合+ 视觉颜色拍照&lt;br&gt;• 自动定量取样（被测液:试剂配比）&lt;br&gt;• 废液自动排出 + 循环检测准备" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#555555;" parent="1" vertex="1"><mxGeometry x="1295" y="628" width="248" height="59" as="geometry"/></mxCell><mxCell id="modA2B" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="modA_box" target="modB_box" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="modB2C" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="modB_box" target="modC_box" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="data_hdr" value="项目关键数据" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;fontColor=#1a1a2e;" parent="1" vertex="1"><mxGeometry x="720" y="740" width="150" height="30" as="geometry"/></mxCell><mxCell id="data_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#cccccc;strokeWidth=1;dashed=1;" parent="1" vertex="1"><mxGeometry x="720" y="775" width="810" height="60" as="geometry"/></mxCell><mxCell id="data_c" value="&lt;b&gt;改造规模：&lt;/b&gt;10条产线 × 24阀门/线 = &lt;b&gt;240个阀门&lt;/b&gt;（DN80×10 + DN65×200 + DN25×30）&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&lt;b&gt;流量范围：&lt;/b&gt;6~16 m³/h&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&lt;b&gt;检测指标：&lt;/b&gt;颜色(青蓝)+pH(7)+比重(1.05~1.08)&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&lt;b&gt;预计周期：&lt;/b&gt;8个月（逐线改造，不停产）" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=10;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="730" y="782" width="790" height="46" as="geometry"/></mxCell></root></mxGraphModel>